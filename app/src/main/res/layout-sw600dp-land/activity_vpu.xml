<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    tools:context=".ui.vpu.VpuActivity">

    <!-- Вертикальная направляющая: слева статус ~36%, справа картинки -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.36" />

    <!-- Левая колонка: статус -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="#121B2E"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#263554"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ВПУ • Управление фазами"
                    android:textColor="#E8EEF9"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <!-- WiFi иконка (индикатор связи) -->
                <ImageView
                    android:id="@+id/wifiIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Wi-Fi"
                    android:src="@drawable/wifi_icon"
                    app:tint="#FF6B6B" />

            </LinearLayout>
            <!-- Строка: статус + РУ + WiFi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Объект: ---  •  Фаза: ---"
                    android:textColor="#E8EEF9"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/manualToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="РУ"
                    android:textColor="#E8EEF9"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hintTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Для запроса РУ - нажмите РУ. Вызов фаз — кнопками 1-8"
                android:textColor="#A7B3C9"
                android:textSize="13sp"/>

            <LinearLayout
                android:id="@+id/phaseButtonsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton1"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="1"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton2"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="2"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton3"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="3"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton4"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="4"
                    app:cornerRadius="999dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phaseButtonsRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton5"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="5"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton6"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="6"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton7"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="7"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton8"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="65dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="8"
                    app:cornerRadius="999dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/manualTimerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Таймер РУ: —"
                android:textColor="#A7B3C9"
                android:textSize="13sp" />


            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Низ левой карточки: подсказка/легенда (опционально) -->
            <TextView
                android:id="@+id/legendTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="РУ: красный — запрет, зелёный — разрешено"
                android:textColor="#A7B3C9"
                android:textSize="12sp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Правая колонка: картинки -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pagerCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#0E1728"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="#263554"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- подпись фазы -->
            <TextView
                android:id="@+id/pageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:padding="8dp"
                android:text="— / —"
                android:textColor="#E8EEF9"
                android:textSize="13sp"
                android:background="#263554"/>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
