<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    tools:context=".ui.vpu.VpuActivity">

    <!-- Вертикальная направляющая: слева статус ~36%, справа картинки -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.36" />

    <!-- Левая колонка: статус -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="#121B2E"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#263554"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ВПУ • Управление фазами"
                android:textColor="#E8EEF9"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Строка: статус + РУ + WiFi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Объект: ---  •  Фаза: ---"
                    android:textColor="#E8EEF9"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <!-- Кнопка РУ (круглая) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manualButton"
                    android:layout_width="71dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="#FF6B6B"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:text="РУ"
                    android:textColor="#0B1220"
                    android:textStyle="bold"
                    app:cornerRadius="999dp" />

                <!-- WiFi иконка (индикатор связи) -->
                <ImageView
                    android:id="@+id/wifiIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Wi-Fi"
                    android:src="@android:drawable/ic_lock_idle_charging"
                    app:tint="#FF6B6B" />
            </LinearLayout>

            <TextView
                android:id="@+id/hintTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Свайп — выбрать фазу. Для запроса РУ - нажмите РУ. Для вызова фазы - кнопка снизу"
                android:textColor="#A7B3C9"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/manualTimerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Таймер РУ: —"
                android:textColor="#A7B3C9"
                android:textSize="13sp" />


            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Низ левой карточки: подсказка/легенда (опционально) -->
            <TextView
                android:id="@+id/legendTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="РУ: красный — запрет, зелёный — разрешено"
                android:textColor="#A7B3C9"
                android:textSize="12sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Правая колонка: картинки -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pagerCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#0E1728"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="#263554"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- подпись фазы -->
            <TextView
                android:id="@+id/pageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:padding="8dp"
                android:text="— / —"
                android:textColor="#E8EEF9"
                android:textSize="13sp"
                android:background="#263554"/>

            <!-- КРУГЛАЯ КНОПКА АКТИВАЦИИ ФАЗЫ (по центру снизу) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/activateButton"
                android:layout_width="108dp"
                android:layout_height="102dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#2EE59D"
                android:enabled="false"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:text=""
                app:cornerRadius="999dp"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconGravity="textStart"
                app:iconTint="#0B1220" />
        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
