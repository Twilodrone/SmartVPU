<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    tools:context=".ui.vpu.VpuActivity">

    <!-- ================= STATUS CARD ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#121B2E"
        app:cardCornerRadius="18dp"
        app:strokeColor="#263554"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ВПУ • Управление фазами"
                    android:textColor="#E8EEF9"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/wifiIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/wifi_icon"
                    app:tint="#FF6B6B" />
            </LinearLayout>

            <!-- строка статус + РУ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="93dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="Объект: ---  •  Текущая: ---"
                    android:textColor="#E8EEF9"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/manualToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:rotation="270"
                    android:scaleX="1.5"
                    android:scaleY="1.5"

                    android:textColor="#E8EEF9"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ruTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:text="РУ"
                    android:textColor="#E8EEF9"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/manualTimerTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ВЫКЛ:(-:-)"
                    android:textColor="#A7B3C9"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/addressTextView"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="Адрес:"
                    android:textColor="#E8EEF9"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/indicationhintTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Посмотреть фазу:"
                android:gravity="center"
                android:textColor="#A7B3C9"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/phaseButtonsRow"
                android:layout_width="match_parent"
                android:layout_height="81dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton1"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="1"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton2"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="2"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton3"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="3"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton4"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="4"
                    app:cornerRadius="999dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton5"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="5"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton6"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="6"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton7"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="7"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phaseButton8"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="8"
                    app:cornerRadius="999dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/activatehintTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Вызвать фазу:"
                android:gravity="center"
                android:textColor="#A7B3C9"
                android:textSize="13sp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф1" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф2" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф3" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф4" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф5" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф6" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф7" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="7dp"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phaseCallSwitch8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rotation="270" android:scaleX="1.5" android:scaleY="1.5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ф8" android:textColor="#E8EEF9" android:textSize="12sp" android:layout_gravity="center_horizontal"/></LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= PAGER CARD ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pagerCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#0E1728"
        app:cardCornerRadius="22dp"
        app:strokeColor="#263554"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/statusCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/activePhaseTimerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:padding="8dp"
                android:text="Фаза активна: --:--"
                android:textColor="#E8EEF9"
                android:textSize="13sp"
                android:background="#263554"/>

            <!-- подпись фазы -->
            <TextView
                android:id="@+id/pageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:padding="8dp"
                android:text="— / —"
                android:textColor="#E8EEF9"
                android:textSize="13sp"
                android:background="#263554"/>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
